# Enquiry form delivery — configure at least one (Vercel → Project → Settings → Environment Variables)

# Option A: send each enquiry as JSON to a CRM / automation webhook
# (GoHighLevel inbound webhook, Zapier "Catch Hook", Make "Custom webhook", HubSpot workflow webhook…)
CONTACT_WEBHOOK_URL=

# Option B: email each enquiry via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="ReeCo Website <website@yourdomain.com>"
